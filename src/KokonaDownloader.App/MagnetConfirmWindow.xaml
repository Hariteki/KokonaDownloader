<Window
    x:Class="KokonaDownloader.App.MagnetConfirmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="磁力链接下载确认">

    <Grid x:Name="Root" RequestedTheme="Dark"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
          Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="是否下载此磁力链接？" FontSize="18" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="NameText" FontSize="13" TextWrapping="Wrap" MaxLines="2"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 链接与目录信息卡片（与设置窗口的卡片样式一致） -->
        <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="磁力链接" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBox x:Name="UrlBox" IsReadOnly="True" IsSpellCheckEnabled="False"
                             FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                             Height="88" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Text="保存目录" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="DirText" FontSize="12" FontFamily="Consolas" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="ErrorText" FontSize="12" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" Visibility="Collapsed"
                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>

        <Grid Grid.Row="3" HorizontalAlignment="Right" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CancelBtn" Content="取消" MinWidth="104" Click="OnCancelClick"/>
            <Button x:Name="StartBtn" Grid.Column="1" Content="开始下载" MinWidth="104"
                    Style="{ThemeResource AccentButtonStyle}" Click="OnConfirmClick"/>
        </Grid>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked"/>
        </Grid.KeyboardAccelerators>
    </Grid>
</Window>
