<Window
    x:Class="KokonaDownloader.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:KokonaDownloader.App.Converters"
    xmlns:controls="using:KokonaDownloader.App.Controls"
    xmlns:local="using:KokonaDownloader.App"
    mc:Ignorable="d"
    Title="海兔下载器">

    <Grid x:Name="RootGrid" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <!-- Metro 风格 Tab：纯文字大标题，无圆点无下划线，选中时主题色+加粗。
                 选中/未选中各一层文字，前景直接引用 ThemeResource 实时颜色，切换只动画透明度（交叉淡入淡出）；
                 不用 ColorAnimation 动画主题色，避免它锁存旧主题颜色快照、切换主题后不立即刷新。
                 悬停时轻微放大并浮现投影制造悬浮感，移开后平滑缩回原大小；按压缩放反馈保持不变。 -->
            <Style x:Key="FilterTabStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="TabRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform/>
                                </Grid.RenderTransform>
                                <!-- 悬停投影宿主：WinUI3 无 XAML DropShadow 类型，用 ThemeShadow（代码挂载）+ Z 抬升制造悬浮投影，
                                     底色用表面色保证投影有实心轮廓，Opacity 动画整体淡入淡出 -->
                                <controls:SquircleBorder x:Name="TabShadowHost" CornerRadius="9" Opacity="0" IsHitTestVisible="False">
                                    <controls:SquircleBorder.Fill>
                                        <SolidColorBrush Color="{ThemeResource TabSurfaceColor}"/>
                                    </controls:SquircleBorder.Fill>
                                </controls:SquircleBorder>
                                <controls:SquircleBorder x:Name="TabHover" CornerRadius="9" IsHitTestVisible="False">
                                    <controls:SquircleBorder.Fill>
                                        <SolidColorBrush x:Name="TabHoverBrush" Color="Transparent"/>
                                    </controls:SquircleBorder.Fill>
                                </controls:SquircleBorder>
                                <ContentPresenter x:Name="TabInactive" Content="{TemplateBinding Content}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.Foreground>
                                        <SolidColorBrush Color="{ThemeResource TabInactiveColor}"/>
                                    </ContentPresenter.Foreground>
                                </ContentPresenter>
                                <ContentPresenter x:Name="TabActive" Content="{TemplateBinding Content}" Opacity="0"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.Foreground>
                                        <SolidColorBrush Color="{ThemeResource TabAccentColor}"/>
                                    </ContentPresenter.Foreground>
                                </ContentPresenter>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="TabHoverBrush" Storyboard.TargetProperty="Color"
                                                                To="Transparent" Duration="0:0:0.2">
                                                    <ColorAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ColorAnimation.EasingFunction>
                                                </ColorAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="1.05" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="1.05" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabShadowHost" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="TabHoverBrush" Storyboard.TargetProperty="Color"
                                                                To="#14FFFFFF" Duration="0:0:0.15">
                                                    <ColorAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ColorAnimation.EasingFunction>
                                                </ColorAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="1" To="1.05" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="1" To="1.05" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabShadowHost" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="TabHoverBrush" Storyboard.TargetProperty="Color"
                                                                To="#33000000" Duration="0:0:0.1">
                                                    <ColorAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ColorAnimation.EasingFunction>
                                                </ColorAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.96" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.96" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabShadowHost" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="TabActive" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabInactive" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="TabInactive" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="TabActive" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- BT 右上角独立按钮：磁力图标 + 文字胶囊，选中态同 Tab 高亮色。
                 与 FilterTabStyle 同理：主题相关颜色全部走 ThemeResource 实时引用（表面层 + 主题色叠加层 + 前景双层），
                 选中/未选中只动画透明度，不用 ColorAnimation 锁存主题色；
                 悬停同样轻微放大 + 投影悬浮，移开缩回淡出；按压反馈保持不变。 -->
            <Style x:Key="BtToggleButtonStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="BtRoot" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform/>
                                </Grid.RenderTransform>
                                <controls:SquircleBorder x:Name="BtShadowHost" CornerRadius="9" Opacity="0" IsHitTestVisible="False">
                                    <controls:SquircleBorder.Fill>
                                        <SolidColorBrush Color="{ThemeResource TabSurfaceColor}"/>
                                    </controls:SquircleBorder.Fill>
                                </controls:SquircleBorder>
                                <controls:SquircleBorder CornerRadius="9">
                                    <controls:SquircleBorder.Fill>
                                        <SolidColorBrush Color="{ThemeResource TabSurfaceColor}"/>
                                    </controls:SquircleBorder.Fill>
                                    <controls:SquircleBorder x:Name="BtAccent" CornerRadius="9" Opacity="0">
                                        <controls:SquircleBorder.Fill>
                                            <SolidColorBrush Color="{ThemeResource TabAccentColor}"/>
                                        </controls:SquircleBorder.Fill>
                                    </controls:SquircleBorder>
                                </controls:SquircleBorder>
                                <controls:SquircleBorder x:Name="BtHover" CornerRadius="9" IsHitTestVisible="False">
                                    <controls:SquircleBorder.Fill>
                                        <SolidColorBrush x:Name="BtHoverBrush" Color="Transparent"/>
                                    </controls:SquircleBorder.Fill>
                                </controls:SquircleBorder>
                                <StackPanel Orientation="Horizontal" Spacing="6" Padding="{TemplateBinding Padding}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid VerticalAlignment="Center">
                                        <FontIcon x:Name="BtIconIdle" Glyph="&#xE896;" FontSize="14">
                                            <FontIcon.Foreground>
                                                <SolidColorBrush Color="{ThemeResource TabInactiveColor}"/>
                                            </FontIcon.Foreground>
                                        </FontIcon>
                                        <FontIcon x:Name="BtIconActive" Glyph="&#xE896;" FontSize="14" Opacity="0" Foreground="White"/>
                                    </Grid>
                                    <Grid VerticalAlignment="Center">
                                        <ContentPresenter x:Name="BtTextIdle" Content="{TemplateBinding Content}">
                                            <ContentPresenter.Foreground>
                                                <SolidColorBrush Color="{ThemeResource TabInactiveColor}"/>
                                            </ContentPresenter.Foreground>
                                        </ContentPresenter>
                                        <ContentPresenter x:Name="BtTextActive" Content="{TemplateBinding Content}"
                                                          Opacity="0" Foreground="White"/>
                                    </Grid>
                                </StackPanel>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BtHoverBrush" Storyboard.TargetProperty="Color"
                                                                To="Transparent" Duration="0:0:0.2">
                                                    <ColorAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ColorAnimation.EasingFunction>
                                                </ColorAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="1.05" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="1.05" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtShadowHost" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BtHoverBrush" Storyboard.TargetProperty="Color"
                                                                To="#14FFFFFF" Duration="0:0:0.15">
                                                    <ColorAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ColorAnimation.EasingFunction>
                                                </ColorAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="1" To="1.05" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="1" To="1.05" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtShadowHost" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="BtHoverBrush" Storyboard.TargetProperty="Color"
                                                                To="#33000000" Duration="0:0:0.1">
                                                    <ColorAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </ColorAnimation.EasingFunction>
                                                </ColorAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.96" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.96" Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtShadowHost" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="1" Duration="0:0:0.12"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtAccent" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtIconActive" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtTextActive" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtIconIdle" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtTextIdle" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtIconIdle" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtTextIdle" Storyboard.TargetProperty="Opacity"
                                                                 From="0" To="1" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtAccent" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtIconActive" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="BtTextActive" Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0" Duration="0:0:0.16">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="{ThemeResource ButtonPadding}"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
                <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootHost" Background="Transparent">
                                <controls:SquircleBorder x:Name="Root"
                                                         Fill="{TemplateBinding Background}"
                                                         BorderThickness="{TemplateBinding BorderThickness}"
                                                         CornerRadius="{TemplateBinding CornerRadius}"/>
                                <ContentPresenter x:Name="ContentPresenter"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  Padding="{TemplateBinding Padding}"
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}"
                                                  Background="Transparent">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal"/>
                                            <VisualState x:Name="PointerOver">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppDangerFillHoverBrush}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Pressed">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Fill">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AppDangerFillPressedBrush}"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                            <VisualState x:Name="Disabled">
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootHost" Storyboard.TargetProperty="Opacity">
                                                        <DiscreteObjectKeyFrame KeyTime="0" Value="0.55"/>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </ContentPresenter>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- 连续曲率卡片：默认模板的 ListViewItemPresenter 只能画标准圆弧角，
                 这里整体重写为自绘模板——底层 SquircleBorder 卡片面（实心卡背景+描边），
                 上层 SquircleBorder 状态着色层（ListViewItemBackground* 本身是半透明叠加色，
                 逐状态换 Fill 即可复刻悬停/按下/选中的系统反馈），选中指示条用 Rectangle。
                 大圆角半径 12，Margin 让相邻卡片留出间距、右侧与列表左 Padding 对齐。
                 主列表与 BT 专用页共用 -->
            <Style x:Key="CardItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="MinHeight" Value="76"/>
                <Setter Property="Padding" Value="4,2"/>
                <Setter Property="Margin" Value="0,3,12,3"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid Background="Transparent" Control.IsTemplateFocusTarget="True"
                                  FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                  FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                  FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                  FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                  FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}">
                                <controls:SquircleBorder x:Name="CardSurface"
                                                         CornerRadius="{TemplateBinding CornerRadius}"
                                                         Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                         Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                                                         BorderThickness="1"/>
                                <controls:SquircleBorder x:Name="CardTint"
                                                         CornerRadius="{TemplateBinding CornerRadius}"
                                                         Fill="Transparent" IsHitTestVisible="False"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="SelectionIndicator" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                               Margin="3,0,0,0" VerticalAlignment="Center" Opacity="0"
                                               Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardTint" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ListViewItemBackgroundPointerOver}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardTint" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ListViewItemBackgroundPressed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="CardSurface" Storyboard.TargetProperty="Opacity"
                                                                 To="{ThemeResource ListViewItemDisabledThemeOpacity}" Duration="0"/>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="SelectionStates">
                                        <VisualState x:Name="Unselected"/>
                                        <VisualState x:Name="Selected">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardTint" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ListViewItemBackgroundSelected}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardTint" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ListViewItemBackgroundSelectedPointerOver}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardTint" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ListViewItemBackgroundSelectedPressed}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="SelectedDisabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CardTint" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ListViewItemBackgroundSelectedDisabled}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Opacity">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="1"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- BT 大卡片：预留完整方块矩阵（12px 块 + 分片统计文字）的更高行高 -->
            <Style x:Key="BtCardItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource CardItemStyle}">
                <Setter Property="MinHeight" Value="130"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏拖拽区：无系统色带，标题融入内容（与设置窗口同款沉浸式样式） -->
        <Border x:Name="TitleDrag" Grid.Row="0" Height="40" Background="Transparent">
            <TextBlock Text="海兔下载器" Margin="24,0,0,0" VerticalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Border>

        <!-- 顶部工具栏 -->
        <Grid Grid.Row="1" Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnNew" Click="OnNewClick" Style="{ThemeResource SquircleAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="新建下载"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnPauseAll" Click="OnPauseAllClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE769;" FontSize="14"/>
                        <TextBlock Text="全部暂停"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnResumeAll" Click="OnResumeAllClick">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE768;" FontSize="14"/>
                        <TextBlock Text="全部开始"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnTheme" ToolTipService.ToolTip="主题配色" AutomationProperties.Name="主题配色">
                    <FontIcon Glyph="&#xE790;" FontSize="16"/>
                    <Button.Flyout>
                        <MenuFlyout x:Name="ThemeMenu" Placement="Bottom"/>
                    </Button.Flyout>
                </Button>
                <Button x:Name="BtnSettings" Click="OnSettingsClick" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置">
                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 筛选与搜索：Tab 栏 + 右侧选择按钮 + 搜索框 -->
        <Grid Grid.Row="2" Padding="16,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                <RadioButton x:Name="FilterAll" Content="全部" GroupName="Filter" IsChecked="True" Click="OnFilterChanged" Style="{StaticResource FilterTabStyle}"/>
                <RadioButton x:Name="FilterActive" Content="下载中" GroupName="Filter" Click="OnFilterChanged" Style="{StaticResource FilterTabStyle}"/>
                <RadioButton x:Name="FilterPaused" Content="已暂停" GroupName="Filter" Click="OnFilterChanged" Style="{StaticResource FilterTabStyle}"/>
                <RadioButton x:Name="FilterDone" Content="已完成" GroupName="Filter" Click="OnFilterChanged" Style="{StaticResource FilterTabStyle}"/>
                <RadioButton x:Name="FilterFailed" Content="失败" GroupName="Filter" Click="OnFilterChanged" Style="{StaticResource FilterTabStyle}"/>
                <!-- 批量选择仅作用于常规列表，BT 专用页隐藏以免误操作不可见列表 -->
                <StackPanel x:Name="BatchPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="1" Height="16" Margin="8,0" VerticalAlignment="Center"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <Button x:Name="BtnBatch" ToolTipService.ToolTip="筛选任务" AutomationProperties.Name="筛选任务"
                            Background="Transparent" BorderThickness="0" Padding="8,2" MinHeight="28">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE71C;" FontSize="13"/>
                            <TextBlock Text="筛选" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="全选" Click="OnSelectAllClick"/>
                                <MenuFlyoutItem Text="反选" Click="OnInvertSelectionClick"/>
                                <MenuFlyoutItem Text="取消选择" Click="OnClearSelectionClick"/>
                                <MenuFlyoutSeparator/>
                                <MenuFlyoutItem Text="暂停选中" Click="OnBatchPauseClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE769;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="继续选中" Click="OnBatchResumeClick">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="删除选中" Click="OnBatchDeleteClick" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
            <!-- 右上角：BT 专用视图入口（独立按钮） + 搜索框 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <RadioButton x:Name="FilterBt" GroupName="Filter" Click="OnFilterChanged"
                             Style="{StaticResource BtToggleButtonStyle}" Content="BT下载"
                             ToolTipService.ToolTip="磁力链接 / 种子文件" AutomationProperties.Name="BT 任务视图"/>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索"
                                QueryIcon="Find" Width="200" MinWidth="120" VerticalAlignment="Center"
                                CornerRadius="8" TextChanged="OnSearchTextChanged"/>
            </StackPanel>
        </Grid>

        <!-- 任务列表：Extended 支持单击选中/Ctrl/Shift 多选，"全选/反选"菜单也可用 -->
        <ListView x:Name="TaskList" Grid.Row="3" Padding="12,0"
                  SelectionMode="Extended" IsItemClickEnabled="False"
                  RightTapped="OnTaskRightTapped"
                  ItemContainerStyle="{StaticResource CardItemStyle}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="16,12" ColumnSpacing="12" Background="Transparent"
                          DoubleTapped="OnItemDoubleTapped" ToolTipService.ToolTip="双击打开所在位置">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 文件名等信息列（双击整张卡片打开所在位置，事件挂在模板根 Grid） -->
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="14"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding SpeedText}" VerticalAlignment="Center" FontSize="13"/>
                        <TextBlock Grid.Column="2" Text="{Binding EtaText}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnItemPauseClick" Visibility="{Binding PauseVisible, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="暂停">
                                    <FontIcon Glyph="&#xE769;" FontSize="15"/>
                                </Button>
                                <Button Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnItemResumeClick" Visibility="{Binding ResumeVisible, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="继续">
                                    <FontIcon Glyph="&#xE768;" FontSize="15"/>
                                </Button>
                                <Button Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnItemOpenClick" ToolTipService.ToolTip="打开文件夹">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="15"/>
                                </Button>
                                <Button Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnItemDeleteClick" ToolTipService.ToolTip="删除">
                                    <FontIcon Glyph="&#xE74D;" FontSize="15"/>
                                </Button>
                            </StackPanel>
                            <!-- 过渡小字：点击暂停/继续后立即出现（图标同步乐观切换），引擎确认后消失；
                                 常驻占位（透明）保证行高恒定不跳动 -->
                            <TextBlock Text="{Binding PendingText}" FontSize="10" Height="13" Opacity="{Binding PendingOpacity}"
                                       HorizontalAlignment="Right" Margin="0,0,4,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- 常规任务：进度条；BT 任务：Motrix 式分片方块矩阵（紧凑单行，最多 100 块） -->
                        <ProgressBar Grid.Row="1" Grid.ColumnSpan="4" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                     HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                     Visibility="{Binding IsBt, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <local:BtPieceGrid Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0"
                                           Compact="True" MetaVisible="False"
                                           BitField="{Binding BitField}" NumPieces="{Binding NumPieces}" IsActive="{Binding IsActive}"
                                           Visibility="{Binding IsBt, Converter={StaticResource BoolToVis}}"/>

                        <!-- 右上角红绿灯：绿=下载中 青=做种中 黄=暂停/排队 蓝=已完成 红=失败；底层为同色径向光晕 -->
                        <Ellipse Grid.ColumnSpan="4" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-14,-16,0" Fill="{Binding StatusGlowBrush}" IsHitTestVisible="False"/>
                        <Ellipse Grid.ColumnSpan="4" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-9,-11,0" Fill="{Binding StatusDotBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- BT 专用页：概要条 + 大卡片列表（完整方块矩阵 12px、最多 400 块，含分片统计） -->
        <Grid x:Name="BtPage" Grid.Row="3" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:SquircleBorder Grid.Row="0" Margin="16,4,16,10" CornerRadius="12"
                    Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Stroke="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="16" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="BtSummaryText" Text="暂无 BT 任务" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE898;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="BtUploadText" Text="" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </controls:SquircleBorder>

            <ListView x:Name="BtList" Grid.Row="1" Padding="12,0"
                      SelectionMode="Extended" IsItemClickEnabled="False"
                      RightTapped="OnTaskRightTapped"
                      ItemContainerStyle="{StaticResource BtCardItemStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="16,14" RowSpacing="10" Background="Transparent"
                              DoubleTapped="OnItemDoubleTapped" ToolTipService.ToolTip="双击打开所在位置">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="14"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnItemPauseClick" Visibility="{Binding PauseVisible, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="暂停">
                                        <FontIcon Glyph="&#xE769;" FontSize="15"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnItemResumeClick" Visibility="{Binding ResumeVisible, Converter={StaticResource BoolToVis}}" ToolTipService.ToolTip="继续">
                                        <FontIcon Glyph="&#xE768;" FontSize="15"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnItemOpenClick" ToolTipService.ToolTip="打开文件夹">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="15"/>
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="OnItemDeleteClick" ToolTipService.ToolTip="删除">
                                        <FontIcon Glyph="&#xE74D;" FontSize="15"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 第二行：体量与速率概要 -->
                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SizeText}" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="13" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 第三行：Motrix 式完整方块矩阵（12px 块、最多 400 块，含分片统计小字） -->
                            <local:BtPieceGrid Grid.Row="2"
                                               Compact="False" MetaVisible="True"
                                               BitField="{Binding BitField}" NumPieces="{Binding NumPieces}" IsActive="{Binding IsActive}"/>

                            <!-- 右上角红绿灯：绿=下载中 青=做种中 黄=暂停/排队 蓝=已完成 红=失败；底层为同色径向光晕 -->
                            <Ellipse Grid.RowSpan="3" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-16,-16,0" Fill="{Binding StatusGlowBrush}" IsHitTestVisible="False"/>
                            <Ellipse Grid.RowSpan="3" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                     Margin="0,-11,-11,0" Fill="{Binding StatusDotBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- 空状态：无任务时居中提示（悬浮于列表区上方） -->
        <Border x:Name="EmptyState" Grid.Row="3" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Opacity="0.8">
                <FontIcon Glyph="&#xE753;" FontSize="42" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                <TextBlock Text="暂无任务" HorizontalAlignment="Center" FontSize="15"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="点击左上角“新建下载”，或直接粘贴磁力链接" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 底部状态栏：全局速率 / 活动统计 / 引擎连接状态（无分割线，完全沉浸式） -->
        <Border Grid.Row="4" Padding="16,6">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="GlobalSpeedText" Text="0 B/s" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <TextBlock x:Name="ActiveCountText" Grid.Column="1" Text="活动 0 · 等待 0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock x:Name="ConnStatusText" Text="引擎未运行" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
