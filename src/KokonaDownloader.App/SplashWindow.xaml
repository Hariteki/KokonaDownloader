<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="KokonaDownloader.App.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="海兔下载器">

    <Grid x:Name="RootGrid" Background="#0F0F1A">
        <!-- 背景微光：中心径向渐变，营造深度感 -->
        <Ellipse Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#1A2A4A" Offset="0"/>
                    <GradientStop Color="#0F0F1A" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            <!-- 图标：下载箭头 + 圆环底座 -->
            <Grid x:Name="IconHost" Width="96" Height="96" Opacity="0">
                <!-- 外圈光晕 -->
                <Ellipse Width="96" Height="96" StrokeThickness="1" Stroke="#2A3A5A">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1A2A4A" Offset="0"/>
                            <GradientStop Color="#0F0F1A" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- 下载箭头 -->
                <FontIcon Glyph="&#xE896;" FontSize="42" Foreground="#4A9EFF"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 应用名称 -->
            <TextBlock x:Name="NameText" Text="海兔下载器"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="#E8E8F0"
                       HorizontalAlignment="Center"
                       Opacity="0"/>
        </StackPanel>
    </Grid>
</Window>
