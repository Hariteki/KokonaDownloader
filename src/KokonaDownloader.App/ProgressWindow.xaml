<Window
    x:Class="KokonaDownloader.App.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KokonaDownloader.App"
    Title="下载进度">

    <!-- IDM 式单任务进度小窗：Acrylic 磨砂背景 + 半透明卡片分层 -->
    <Grid x:Name="RootGrid" Background="Transparent" Padding="16,0,16,14" RowSpacing="10" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏拖拽区：任务名融入内容（与设置窗口同款沉浸式样式），右侧避开系统 caption 按钮 -->
        <Border x:Name="TitleDrag" Grid.Row="0" Height="32" Background="Transparent">
            <TextBlock x:Name="TitleText" Margin="12,0,120,0" VerticalAlignment="Center"
                       FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Border>

        <!-- 状态行 -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Text="下载中" FontSize="13"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="13" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 进度条（加粗，厚度由 App.xaml 的 ProgressBar 资源统一控制） -->
        <ProgressBar x:Name="Bar" Grid.Row="2" Value="0" Minimum="0" Maximum="100" CornerRadius="9"/>

        <!-- BT 任务：Motrix 式完整方块矩阵替代进度条（12px 块、最多 400 块，含分片统计） -->
        <local:BtPieceGrid x:Name="PieceGrid" Grid.Row="2" Compact="False" MetaVisible="True"
                           Visibility="Collapsed" HorizontalAlignment="Left"/>

        <!-- 速度 / 大小 / 剩余时间 -->
        <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock x:Name="SpeedText" Text="0 B/s" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock x:Name="SizeText" Grid.Column="1" Text="0 B / 0 B" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="EtaText" Grid.Column="2" Text="" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="BtnPause" Click="OnPauseClick" Padding="10,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="13"/>
                    <TextBlock x:Name="PauseLabel" Text="暂停" FontSize="12"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnOpenFolder" Click="OnOpenFolderClick" Padding="10,6" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8DA;" FontSize="13"/>
                    <TextBlock Text="打开文件夹" FontSize="12"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnClose" Click="OnCloseClick" Padding="10,6">
                <TextBlock Text="关闭" FontSize="12"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
