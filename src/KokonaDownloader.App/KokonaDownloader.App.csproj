<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>KokonaDownloader.App</RootNamespace>
    <AssemblyName>KokonaDownloader</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标：exe 内嵌图标（资源管理器/任务栏/快捷方式默认图标），源为 icons 包 app\app.ico -->
    <ApplicationIcon>..\..\icons\app\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CsWinRT 源生成器（WASDK 1.8）生成的实例化代码含 unsafe，需显式允许 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 版本号（Version/AssemblyVersion/FileVersion/InformationalVersion）唯一来源：
         ..\Directory.Build.props；运行时 /api/ping 从程序集特性读取，勿在此重复定义 -->
    <WindowsSdkPackageVersion>10.0.19041.38</WindowsSdkPackageVersion>
    <!-- PRI 固定为通用名 resources.pri（MRT 找不到 exe 派生名时的回退名），
         修复 WASDK 1.8+ 单文件应用 exe 改名后 ms-appx 解析失败启动即崩的问题
         （WindowsAppSDK#6248） -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6901" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KokonaDownloader.Core\KokonaDownloader.Core.csproj" />
  </ItemGroup>

  <!-- WinForms 仅用于托盘 NotifyIcon；用 FrameworkReference 引入，
       避免 UseWindowsForms 触发 WindowsDesktop SDK 的 WPF XAML 管线与 WinUI 冲突 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\vendor\aria2\aria2c.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="aria2c.exe" />
    <!-- 托盘底图与窗口/任务栏图标（titlebar-tray 造型）：随发布输出，单文件打包时嵌入 exe -->
    <None Include="..\..\icons\titlebar-tray\tray.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="icons\tray.ico" />
    <None Include="..\..\icons\titlebar-tray\icon-32.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="icons\tray.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WindowsPackageType=None 时 publish 默认不带 XBF/PRI，显式补齐，保证发布目录可直接运行；
       单文件发布管线也不会搬运 None 项（aria2c.exe/托盘图标），同样从构建输出目录补齐 -->
  <Target Name="CopyXamlResourcesToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <!-- xbf 用 **\ 递归：Themes\ThemeSwatchPicker.xbf 等子目录页面也必须随发布输出，
           否则设置窗口加载 ThemeSwatchPicker 会因缺 xbf 而 XamlParseException -->
      <!-- 取自 obj（XAML 编译器产物目录）：干净构建下 bin 不会被自动写入 xbf -->
      <_XamlRes Include="$(IntermediateOutputPath)**\*.xbf" Exclude="$(IntermediateOutputPath)embed\**" />
      <_XamlRes Include="$(TargetDir)$(ProjectPriFileName)" />
      <_XamlRes Include="$(TargetDir)aria2c.exe" />
      <_TrayIcons Include="$(TargetDir)icons\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlRes)" DestinationFolder="$(PublishDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TrayIcons)" DestinationFolder="$(PublishDir)icons\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- PRI 生成链里的 _GenerateProjectPriConfigurationFiles 会把 @(_EmbedFile)（bin 下的 xbf）
        复制到 obj\embed\；但干净构建下 bin 还没有 xbf（XAML 编译器只把产物写到 obj），Copy 会 MSB3030。
        这里在 PRI 链跑到该目标前，先把 obj 的 xbf 补一份到 bin，使状态与 publish 时一致（bin 有 xbf）。 -->
  <Target Name="CopyXbfToBinForPri" BeforeTargets="_GenerateProjectPriConfigurationFiles">
    <ItemGroup>
      <_XbfToBin Include="$(IntermediateOutputPath)**\*.xbf" Exclude="$(IntermediateOutputPath)embed\**" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)" Condition="!Exists('$(TargetDir)')" />
    <Copy SourceFiles="@(_XbfToBin)" DestinationFolder="$(TargetDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- 单文件独立运行：把单文件管线不会搬运的散文件嵌入 exe 作为资源，
        启动时由 StandaloneBootstrap（[ModuleInitializer]）在 XAML 初始化前解压到 exe 旁。
        aria2c.exe / 托盘图标取自源码树固定路径。LogicalName 统一 standalone/ 前缀 -->
  <!-- 钩子必须是 _GenerateCompileInputs（CompileDependsOn 链中先于 CoreCompile 运行）：
        它在 CoreCompile 之前把 @(EmbeddedResource) 快照进 @(_CoreCompileResourceInputs)，
        csc 只接收该快照。若挂在 BeforeTargets="CoreCompile"，本目标反而在快照之后运行，项会被漏掉。
        同时本目标在 PrepareResources/SplitResourcesByCulture 之后运行，项不会经过 AssignCulture，
        必须显式声明 WithCulture/Type 元数据，否则 _GenerateCompileInputs 会把它们过滤掉 -->
  <!-- xbf 取自 obj（$(IntermediateOutputPath)）：XAML 编译器（MarkupCompilePass1/2，PrepareResources 阶段）
        把编译产物写到 obj\...\win-x64\，此时 bin 还是空的，不能从 TargetDir 取；
        排除 embed\ 子目录（MRT _EmbedFileCopy 的副本，避免重复嵌入）。 -->
  <!-- resources.pri 由本目标 DependsOnTargets 在 CoreCompile 之前显式生成（MRT 标准链：
        _GetSdkToolPaths → GetMrtPackagingOutputs → _GetDefaultResourceLanguage → _GenerateProjectPriFile），
        makepri 把 PRI 写到 bin\...\resources.pri，csc 时已存在；
        Exists() 条件保证未生成 PRI 的开发构建不会 CS1566。 -->
  <!-- 关键坑：在 <Target> 内创建项时，元数据里引用 %(RecursiveDir)%(Filename)%(Extension)
       会求值为空（8 个 xbf 全部塌成裸 "standalone/" → CS1508 资源标识符重复）。
       同样的 %(RecursiveDir) 在任务输入参数里却能正常求值。
       因此 xbf 的 LogicalName 用 C# 内联任务按相对路径计算并写回，其余项用固定字符串。 -->
  <UsingTask TaskName="SetStandaloneLogicalNames" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs">
        <![CDATA[
        using System;
        using Microsoft.Build.Framework;

        public class SetStandaloneLogicalNames : ITask
        {
          public ITaskItem[] Items { get; set; }
          public string Prefix { get; set; }
          public string ProjectDir { get; set; }
          [Microsoft.Build.Framework.Output]
          public ITaskItem[] ResultItems { get; set; }
          public IBuildEngine BuildEngine { get; set; }
          public ITaskHost HostObject { get; set; }

          public bool Execute()
          {
            string prefix = Prefix;
            if (prefix != null && !System.IO.Path.IsPathRooted(prefix))
            {
              string baseDir = ProjectDir;
              if (string.IsNullOrEmpty(baseDir)) baseDir = System.IO.Directory.GetCurrentDirectory();
              prefix = System.IO.Path.GetFullPath(System.IO.Path.Combine(baseDir, prefix));
            }
            var results = new System.Collections.Generic.List<ITaskItem>();
            if (Items != null)
            {
              foreach (var item in Items)
              {
                string full = item.GetMetadata("FullPath");
                if (string.IsNullOrEmpty(full)) full = item.ItemSpec;
                if (!System.IO.Path.IsPathRooted(full)) full = System.IO.Path.GetFullPath(full);
                if (prefix != null && full.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                {
                  string rel = full.Substring(prefix.Length).TrimStart('\\', '/');
                  rel = rel.Replace('\\', '/');
                  var newItem = new Microsoft.Build.Utilities.TaskItem(item.ItemSpec);
                  foreach (var meta in new[] { "WithCulture", "Type" })
                  {
                    string val = item.GetMetadata(meta);
                    if (!string.IsNullOrEmpty(val)) newItem.SetMetadata(meta, val);
                  }
                  newItem.SetMetadata("LogicalName", "standalone/" + rel);
                  results.Add(newItem);
                }
                else
                {
                  results.Add(item);
                }
              }
            }
            ResultItems = results.ToArray();
            return true;
          }
        }
        ]]>
      </Code>
      <Reference Include="Microsoft.Build.Framework" />
    </Task>
  </UsingTask>

  <Target Name="EmbedStandalonePayload" BeforeTargets="_GenerateCompileInputs"
          DependsOnTargets="_GetSdkToolPaths;GetMrtPackagingOutputs;_GetDefaultResourceLanguage;_GenerateProjectPriFile">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)**\*.xbf" Exclude="$(IntermediateOutputPath)embed\**">
        <WithCulture>false</WithCulture>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
      <EmbeddedResource Include="$(TargetDir)$(ProjectPriFileName)" Condition="Exists('$(TargetDir)$(ProjectPriFileName)')" LogicalName="standalone/$(ProjectPriFileName)">
        <WithCulture>false</WithCulture>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
      <EmbeddedResource Include="..\..\vendor\aria2\aria2c.exe" LogicalName="standalone/aria2c.exe">
        <WithCulture>false</WithCulture>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
      <EmbeddedResource Include="..\..\icons\titlebar-tray\tray.ico" LogicalName="standalone/icons/tray.ico">
        <WithCulture>false</WithCulture>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
      <EmbeddedResource Include="..\..\icons\titlebar-tray\icon-32.png" LogicalName="standalone/icons/tray.png">
        <WithCulture>false</WithCulture>
        <Type>Non-Resx</Type>
      </EmbeddedResource>
    </ItemGroup>
    <SetStandaloneLogicalNames Items="@(EmbeddedResource)" Prefix="$(IntermediateOutputPath)" ProjectDir="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ResultItems" ItemName="_StandaloneEmbeddedResources" />
    </SetStandaloneLogicalNames>
    <ItemGroup>
      <EmbeddedResource Remove="@(EmbeddedResource)" />
      <EmbeddedResource Include="@(_StandaloneEmbeddedResources)" />
    </ItemGroup>
  </Target>
</Project>
