<Application
    x:Class="KokonaDownloader.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 全局加粗进度条：覆盖 WinUI 默认模板资源（轨道默认 1px / 填充 3px） -->
            <x:Double x:Key="ProgressBarMinHeight">18</x:Double>
            <x:Double x:Key="ProgressBarTrackHeight">18</x:Double>
            <CornerRadius x:Key="ProgressBarCornerRadius">9</CornerRadius>
            <CornerRadius x:Key="ProgressBarTrackCornerRadius">9</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
