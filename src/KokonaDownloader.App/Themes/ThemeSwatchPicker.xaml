<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="KokonaDownloader.App.Themes.ThemeSwatchPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KokonaDownloader.App.Themes"
    xmlns:controls="using:KokonaDownloader.App.Controls">

    <UserControl.Resources>
        <!-- 色卡按钮：透明背景 + 悬停反馈，选中环与勾选由数据驱动 -->
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <controls:SquircleBorder x:Name="Root" CornerRadius="12" IsHitTestVisible="False"
                                                     Fill="{TemplateBinding Background}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Fill">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/>
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </controls:SquircleBorder>
                            <ContentPresenter Margin="2,6,2,5"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{x:Bind Items}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:ThemeSwatchViewModel">
                <Button Style="{StaticResource SwatchButtonStyle}" Click="OnSwatchClick"
                        AutomationProperties.Name="{x:Bind Name}" MinWidth="56">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <controls:SquircleBorder Stroke="{x:Bind RingBrush, Mode=OneWay}" BorderThickness="2"
                                                 CornerRadius="12">
                            <Grid Width="32" Height="24" Margin="4">
                                <controls:SquircleBorder CornerRadius="8" Fill="{x:Bind SwatchBrush}"/>
                                <FontIcon Glyph="&#xE73E;" FontSize="11"
                                          Foreground="{x:Bind CheckGlyphBrush}"
                                          Visibility="{x:Bind CheckVisibility, Mode=OneWay}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </controls:SquircleBorder>
                        <TextBlock Text="{x:Bind Name}" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
