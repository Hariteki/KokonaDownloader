<ContentDialog
    x:Class="KokonaDownloader.App.NewDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="新建下载"
    PrimaryButtonText="开始下载"
    SecondaryButtonText="取消"
    PrimaryButtonStyle="{ThemeResource SquircleAccentButtonStyle}"
    SecondaryButtonStyle="{ThemeResource SquircleButtonStyle}"
    DefaultButton="Primary"
    MinWidth="520">

    <StackPanel Spacing="14" Padding="0,8,0,0">
        <StackPanel Spacing="4">
            <TextBlock Text="下载地址（每行一个，支持批量；支持磁力链接）" FontSize="13"/>
            <TextBox x:Name="UrlBox" Style="{ThemeResource SquircleTextBoxStyle}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                     PlaceholderText="https://example.com/file.zip&#x0a;magnet:?xt=urn:btih:…"/>
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Content="选择 .torrent 文件…" Click="OnBrowseTorrent"/>
                <TextBlock x:Name="TorrentFileText" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"/>
                <HyperlinkButton x:Name="ClearTorrentBtn" Content="清除" Padding="4,0"
                                 Click="OnClearTorrent" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock x:Name="TorrentHint" FontSize="12" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="已选择种子文件，提交后忽略地址栏内容；文件名与线程数由种子决定。"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="保存目录" FontSize="13"/>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DirBox" Grid.Column="0" Style="{ThemeResource SquircleTextBoxStyle}"/>
                <Button Grid.Column="1" Click="OnBrowseDir" Content="浏览…"/>
            </Grid>
        </StackPanel>

        <StackPanel x:Name="FileNamePanel" Spacing="4">
            <TextBlock Text="文件名（留空则自动识别）" FontSize="13"/>
            <TextBox x:Name="FileNameBox" Style="{ThemeResource SquircleTextBoxStyle}" PlaceholderText="自动"/>
        </StackPanel>

        <Grid ColumnSpacing="16" x:Name="OptionsGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="线程数" FontSize="13"/>
                <NumberBox x:Name="ConnBox" Minimum="1" Maximum="32" SpinButtonPlacementMode="Inline" Value="8"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="单任务限速（0 = 不限）" FontSize="13"/>
                <ComboBox x:Name="LimitBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                    <ComboBoxItem Content="不限速" Tag="0"/>
                    <ComboBoxItem Content="100 KB/s" Tag="102400"/>
                    <ComboBoxItem Content="500 KB/s" Tag="512000"/>
                    <ComboBoxItem Content="1 MB/s" Tag="1048576"/>
                    <ComboBoxItem Content="5 MB/s" Tag="5242880"/>
                    <ComboBoxItem Content="10 MB/s" Tag="10485760"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</ContentDialog>
