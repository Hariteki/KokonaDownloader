{
  "manifest_version": 3,
  "name": "海兔下载器",
  "version": "2.2.0",
  "key": "",
  "description": "把浏览器的下载交给海兔下载器桌面客户端：多线程分段、断点续传。",
  "minimum_chrome_version": "102",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "scripting",
    "activeTab",
    "cookies",
    "notifications",
    "declarativeNetRequestWithHostAccess",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "海兔下载器",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "ui/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
